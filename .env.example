# ===== Model =====
LLM_API_KEY= #your_api_key
LLM_MODEL= #your_model_name
LLM_FAST_MODEL= #your_fast_model_name
LLM_GRADE_MODEL= #your_grade_model_name
LLM_BASE_URL= #https://your-llm-endpoint/v1

# 本地密集向量（langchain_huggingface，默认 BAAI/bge-m3）
EMBEDDING_MODEL= #BAAI/bge-m3
EMBEDDING_DEVICE= #cpu
EMBEDDING_BATCH_SIZE=16
EMBEDDING_MAX_LENGTH=1024
# blocking（默认，启动完成即就绪）/ background（配合 /readyz）/ disabled（首次请求加载）
EMBEDDING_PRELOAD=background
DENSE_EMBEDDING_DIM= #1024

# ===== Rerank (可选，不配则自动降级) =====
RERANK_PROVIDER=jina # jina / tei
RERANK_MODEL= # jina-reranker-v3 / BAAI/bge-reranker-v2-m3
RERANK_BINDING_HOST= # https://api.jina.ai / http://127.0.0.1:8081
RERANK_API_KEY= # Jina 必填；本地 TEI 可留空
RERANK_TIMEOUT_SECONDS=15

# 独立 TEI reranker 容器
TEI_RERANKER_MODEL=BAAI/bge-reranker-v2-m3
TEI_RERANKER_PORT=8081
TEI_MAX_CLIENT_BATCH_SIZE=32
TEI_MAX_CONCURRENT_REQUESTS=32
# 默认 Compose 服务使用 CPU 镜像；GPU 使用 docker-compose.reranker-gpu.yml 覆盖
TEI_RERANKER_IMAGE=ghcr.io/huggingface/text-embeddings-inference:cpu-1.9
TEI_RERANKER_GPU_IMAGE=ghcr.io/huggingface/text-embeddings-inference:89-1.9
HF_TOKEN=

# ===== 检索 & 召回 =====
# 精排后返回给 Agent 的片段数
RETRIEVAL_TOP_K=8
# Milvus 叶子层召回候选数：设 RETRIEVAL_CANDIDATE_K 时优先使用（且 >= top_k）
# 未设 K 时：candidate_k = max(top_k * RETRIEVAL_CANDIDATE_MULTIPLIER, top_k)
RETRIEVAL_CANDIDATE_K=30
RETRIEVAL_CANDIDATE_MULTIPLIER=3
AUTO_MERGE_ENABLED=true
AUTO_MERGE_THRESHOLD=2
LEAF_RETRIEVE_LEVEL=3

# ===== Milvus =====
MILVUS_HOST=127.0.0.1
MILVUS_PORT=19530
MILVUS_COLLECTION=embeddings_collection
MILVUS_SOFT_DELETE_ENABLED=true
# 单次 RPC 超时（秒）；连接按请求创建，不长期占用 gRPC channel
MILVUS_TIMEOUT=30

# ===== Database / Cache =====
DATABASE_URL=postgresql+psycopg2://postgres:postgres@127.0.0.1:5432/chatcat_app
REDIS_URL=redis://127.0.0.1:6379/0

# ===== Auth =====
JWT_SECRET_KEY=replace-with-strong-random-secret
ADMIN_INVITE_CODE=chatcat-admin-2026
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440
PASSWORD_PBKDF2_ROUNDS=310000

# ===== Tools （可选）=====
AMAP_WEATHER_API=https://restapi.amap.com/v3/weather/weatherInfo
AMAP_API_KEY= #your_amap_api_key

# ===== LangSmith 评估 =====
# 去 https://smith.langchain.com 生成 API Key，填入 .env
LANGSMITH_TRACING=true
LANGSMITH_API_KEY= #lsv2_xxxxxxxx
LANGSMITH_PROJECT=ChatCat
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
